TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_ID=
# Only these Telegram chat IDs receive automatic replies during development.
# Set * to reply in all chats permitted by Telegram account settings.
ALLOWED_CHAT_IDS=*
SALES_DB_PATH=/data/sales.db
# Optional outside Railway. Railway provides RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_BASE_URL=
# Optional: real dialogue via Yandex. Without both values the scripted demo works.
YANDEX_API_KEY=
YANDEX_MODEL_URI=
